<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No uses-permission entries: S1 and S2 fail the build if any network or broad storage permission appears. -->

    <application
        android:allowBackup="false"
        android:label="FileForge"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 0 spike: parser sandbox with no storage or network rights. -->
        <service
            android:name=".spike.ParserService"
            android:exported="false"
            android:isolatedProcess="true" />
    </application>
</manifest>
